# =============================================================================
# Multi-Agent SDLC Orchestrator — Environment Configuration Template
# Copy this file to .env and fill in the required credentials. Never commit .env
# =============================================================================

# --- LLM Provider Configuration ---
# Supported providers: "groq" (cloud API, recommended for hosted deployment) or "ollama" (local)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Ollama Configuration (used only when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384

# --- Backend Database Configuration ---
# Async SQLAlchemy connection string (PostgreSQL or SQLite with aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./backend/database.sqlite
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- GitHub Integration (used by agents for automated branch & PR creation) ---
GITHUB_TOKEN=

# --- Jira Integration (used by Planning / Task Breakdown agents) ---
JIRA_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# --- Slack Integration (used for real-time sprint & deployment notifications) ---
SLACK_BOT_TOKEN=

# --- Orchestrator & Runtime Paths ---
CHECKPOINT_DB_PATH=checkpoints.sqlite
OUTPUT_DIR=output

# --- Frontend Configuration (Next.js / Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

